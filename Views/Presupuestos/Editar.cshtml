@model WebViajes.Models.Presupuesto
@{
    ViewData["Title"] = Model.Nombre;
    var inicial = new
    {
        id = Model.Id,
        nombre = Model.Nombre,
        notas = Model.Notas,
        participantes = Model.Participantes.Select(p => p.Nombre),
        partidas = Model.Partidas.Select(p => new
        {
            concepto = p.Concepto,
            importeDirecto = p.ImporteDirecto,
            nota = p.Nota,
            detalles = p.Detalles.Select(d => new { concepto = d.Concepto, importe = d.Importe, nota = d.Nota })
        })
    };
}

@Html.AntiForgeryToken()

<div class="d-flex align-items-center mb-2">
    <input id="nombre" class="form-control form-control-lg me-3" value="@Model.Nombre" />
    <button id="btnGuardar" class="btn btn-success">Guardar</button>
    <a asp-action="Pdf" asp-route-id="@Model.Id" target="_blank" class="btn btn-outline-secondary ms-2 text-nowrap">
        Descargar PDF
    </a>
</div>
<a asp-action="Index">Volver a mis presupuestos</a>
<div id="estado" class="text-muted mb-3"></div>
<table id="tabla_presupuesto" class="table align-middle">
    <thead>
        <tr>
            <th>Concepto</th>
            <th style="width:150px">Importe</th>
            <th>Nota</th>
            <th style="width:160px"></th>
        </tr>
    </thead>
    <tbody id="cuerpo"></tbody>
</table>
<button id="btnAddPartida" class="btn btn-outline-primary mb-4">+ Añadir concepto</button>

<div class="card mb-4" style="max-width:420px">
    <div class="card-body">
        <div class="d-flex justify-content-between"><span>Total</span><strong id="total"></strong></div>
        <div class="d-flex justify-content-between">
            <span>Por persona (<span id="nPersonas">0</span>)</span><strong id="porPersona"></strong>
        </div>
    </div>
</div>

<h5>Participantes</h5>
<div class="input-group mb-2" style="max-width:420px">
    <input id="nuevoParticipante" class="form-control" placeholder="Nombre" />
    <button id="btnAddParticipante" class="btn btn-outline-primary">Añadir</button>
</div>
<div id="listaParticipantes" class="mb-4"></div>

<h5>Notas</h5>
<textarea id="notas" class="form-control mb-3" rows="3">@Model.Notas</textarea>

@section Scripts {
    <script>
        const datos = @Json.Serialize(inicial);
        const urlGuardar = '@Url.Action("Guardar", "Presupuestos")';
        const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

        const esc = s => (s ?? '').toString().replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;');
        const num = v => { const n = parseFloat(v); return isNaN(n) ? 0 : n; };
        const fmt = n => n.toLocaleString('es-ES', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' €';
        const importePartida = p => p.detalles.length
            ? p.detalles.reduce((s, d) => s + num(d.importe), 0)
            : num(p.importeDirecto);

        const cuerpo = document.getElementById('cuerpo');

        function render() {
            cuerpo.innerHTML = datos.partidas.map((p, i) => {
                const tiene = p.detalles.length > 0;
                let html = `<tr>
                                                                                                            <td><input class="form-control" data-p="${i}" data-f="concepto" value="${esc(p.concepto)}" placeholder="Billete, hotel, comida..."></td>
                                                                                                            <td>${tiene
                        ? `<strong data-total-p="${i}"></strong>`
                        : `<input type="number" step="0.01" class="form-control" data-p="${i}" data-f="importeDirecto" value="${p.importeDirecto ?? ''}">`}</td>
                                                                                                            <td><input class="form-control" data-p="${i}" data-f="nota" value="${esc(p.nota)}"></td>
                                                                                                            <td class="text-nowrap">
                                                                                                                <button class="btn btn-sm btn-outline-secondary" data-act="desglosar" data-p="${i}">${tiene ? 'añadir fila' : 'Desglosar'}</button>
                                                                                                                <button class="btn btn-sm btn-outline-danger" data-act="borrar" data-p="${i}">✕</button>
                                                                                                            </td></tr>`;
                p.detalles.forEach((d, j) => {
                    html += `<tr class="table-light">
                                                                                                                <td class="ps-4"><input class="form-control form-control-sm" data-p="${i}" data-d="${j}" data-f="concepto" value="${esc(d.concepto)}" placeholder="Detalle"></td>
                                                                                                                <td><input type="number" step="0.01" class="form-control form-control-sm" data-p="${i}" data-d="${j}" data-f="importe" value="${d.importe ?? ''}"></td>
                                                                                                                <td><input class="form-control form-control-sm" data-p="${i}" data-d="${j}" data-f="nota" value="${esc(d.nota)}"></td>
                                                                                                                <td><button class="btn btn-sm btn-outline-danger" data-act="borrarDetalle" data-p="${i}" data-d="${j}">✕</button></td>
                                                                                                            </tr>`;
                });
                return html;
            }).join('');
            actualizarTotales();
        }

        function renderParticipantes() {
            document.getElementById('listaParticipantes').innerHTML = datos.participantes.map((n, i) =>
                `<span class="badge bg-secondary me-1 fs-6">${esc(n)} <a href="#" class="text-white text-decoration-none" data-quitar="${i}">×</a></span>`
            ).join('');
            actualizarTotales();
        }

        function actualizarTotales() {
            let total = 0;
            datos.partidas.forEach((p, i) => {
                const imp = importePartida(p);
                total += imp;
                const el = document.querySelector(`[data-total-p="${i}"]`);
                if (el) el.textContent = fmt(imp);
            });
            const n = datos.participantes.length;
            document.getElementById('total').textContent = fmt(total);
            document.getElementById('nPersonas').textContent = n;
            document.getElementById('porPersona').textContent = n ? fmt(total / n) : '—';
        }

        // Escribir en una celda: actualiza los datos y los totales sin redibujar
        cuerpo.addEventListener('input', e => {
            const t = e.target;
            if (t.dataset.p === undefined) return;
            const val = t.type === 'number' ? (t.value === '' ? null : parseFloat(t.value)) : t.value;
            if (t.dataset.d !== undefined) datos.partidas[t.dataset.p].detalles[t.dataset.d][t.dataset.f] = val;
            else datos.partidas[t.dataset.p][t.dataset.f] = val;
            actualizarTotales();
        });

        // Botones de cada fila
        cuerpo.addEventListener('click', e => {
            const b = e.target.closest('button');
            if (!b) return;
            const i = +b.dataset.p;
            if (b.dataset.act === 'borrar') {
                datos.partidas.splice(i, 1);
            } else if (b.dataset.act === 'desglosar') {
                const p = datos.partidas[i];
                // El primer detalle recoge el importe que ya estuviera escrito
                p.detalles.push({ concepto: '', importe: p.detalles.length ? 0 : (p.importeDirecto ?? 0), nota: '' });
                p.importeDirecto = null;
            } else if (b.dataset.act === 'borrarDetalle') {
                datos.partidas[i].detalles.splice(+b.dataset.d, 1);
            }
            render();
        });

        document.getElementById('btnAddPartida').addEventListener('click', () => {
            datos.partidas.push({ concepto: '', importeDirecto: null, nota: '', detalles: [] });
            render();
        });

        function addParticipante() {
            const input = document.getElementById('nuevoParticipante');
            const nombre = input.value.trim();
            if (!nombre) return;
            datos.participantes.push(nombre);
            input.value = '';
            renderParticipantes();
        }
        document.getElementById('btnAddParticipante').addEventListener('click', addParticipante);
        document.getElementById('nuevoParticipante').addEventListener('keydown', e => {
            if (e.key === 'Enter') addParticipante();
        });
        document.getElementById('listaParticipantes').addEventListener('click', e => {
            const a = e.target.closest('[data-quitar]');
            if (!a) return;
            e.preventDefault();
            datos.participantes.splice(+a.dataset.quitar, 1);
            renderParticipantes();
        });

        document.getElementById('btnGuardar').addEventListener('click', async () => {
            datos.nombre = document.getElementById('nombre').value;
            datos.notas = document.getElementById('notas').value;
            const estado = document.getElementById('estado');
            try {
                const r = await fetch(urlGuardar, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
                    body: JSON.stringify(datos)
                });
                estado.textContent = r.ok ? 'Guardado ✓' : 'No se pudo guardar (error ' + r.status + ')';
            } catch {
                estado.textContent = 'No se pudo guardar';
            }
        });

        render();
        renderParticipantes();
    </script>
}