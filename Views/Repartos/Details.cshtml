@model WebViajes.Models.ResumenReparto

@{
    ViewData["Title"] = Model.Nombre;
    var es = new System.Globalization.CultureInfo("es-ES");
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <h1 class="mb-0">@Model.Nombre</h1>

    <div class="d-flex align-items-center flex-wrap gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-secondary text-nowrap">Editar nombre</a>
        <a asp-action="Pdf" asp-route-id="@Model.Id" target="_blank" rel="noopener"
           class="btn btn-outline-dark text-nowrap">Descargar PDF</a>
    </div>
</div>
<a asp-action="Index" class="btn btn-link">Volver a mis repartos</a>

@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger">@error</div>
}

<h4>Miembros</h4>
@if (!Model.Miembros.Any())
{
    <p class="text-muted">Aún no hay miembros. Añade a las personas del grupo para poder crear gastos.</p>
}
else
{
    <div class="d-flex flex-wrap gap-2 mb-3">
        @foreach (var m in Model.Miembros)
        {
            <form asp-controller="Miembros" asp-action="Delete" asp-route-id="@m.Id" method="post"
                  onsubmit="return confirm('¿Borrar a @m.Nombre?');">
                <span class="badge bg-secondary fs-6 d-inline-flex align-items-center gap-2">
                    @m.Nombre
                    <button type="submit" class="btn-close btn-close-white" style="font-size:.6rem"
                            aria-label="Borrar"></button>
                </span>
            </form>
        }
    </div>
}

<form asp-controller="Miembros" asp-action="Create" method="post" class="row g-2 mb-4">
    <input type="hidden" name="repartoId" value="@Model.Id" />
    <div class="col-auto">
        <input type="text" name="nombre" class="form-control" placeholder="Nombre del miembro" maxlength="60"
               required />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-primary">Añadir miembro</button>
    </div>
</form>

<div class="d-flex justify-content-between align-items-center mt-4 mb-2">
    <h4 class="mb-0">Gastos</h4>
    <a asp-controller="Gastos" asp-action="Create" asp-route-repartoId="@Model.Id" class="btn btn-primary">Añadir
        gasto</a>
    </div>

    @if (!Model.Gastos.Any())
    {
        <p class="text-muted">Aún no hay gastos.</p>
    }
    else
    {
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Fecha</th>
                    <th>Concepto</th>
                    <th>Pagó</th>
                    <th>Participan</th>
                    <th class="text-end">Importe</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var g in Model.Gastos)
                {
                    <tr>
                        <td>@g.Fecha.ToString("dd/MM/yyyy")</td>
                        <td>
                            @g.Concepto
                            @if (!string.IsNullOrEmpty(g.Notas))
                            {
                                <div class="small text-muted">@g.Notas</div>
                            }
                        </td>
                        <td>@g.PagadoPor</td>
                        <td>@g.Participantes</td>
                        <td class="text-end">@g.Importe.ToString("N2", es) €</td>
                        <td class="text-end text-nowrap">
                            <a asp-controller="Gastos" asp-action="Edit" asp-route-id="@g.Id"
                               class="btn btn-sm btn-outline-secondary">Editar</a>
                            <form asp-controller="Gastos" asp-action="Delete" asp-route-id="@g.Id" method="post" class="d-inline"
                                  onsubmit="return confirm('¿Borrar este gasto?');">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Borrar</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <div class="text-end fw-semibold">Total: @Model.Total.ToString("N2", es) €</div>

        <hr class="my-4" />

        <h4 class="mb-2">Reparto automático</h4>

        <h6 class="mt-3">Balance</h6>
        <table class="table table-sm align-middle">
            <thead>
                <tr>
                    <th>Miembro</th>
                    <th class="text-end">Ha pagado</th>
                    <th class="text-end">Le corresponde</th>
                    <th class="text-end">Saldo</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var b in Model.Balances)
                {
                    var clase = b.Saldo > 0 ? "text-success" : b.Saldo < 0 ? "text-danger" : "";
                    <tr>
                        <td>@b.Nombre</td>
                        <td class="text-end">@b.Pagado.ToString("N2", es) €</td>
                        <td class="text-end">@b.Debe.ToString("N2", es) €</td>
                        <td class="text-end fw-semibold @clase">@b.Saldo.ToString("N2", es) €</td>
                    </tr>
                }
            </tbody>
        </table>

        <h6 class="mt-4">Quién paga a quién</h6>
        @if (!Model.Liquidaciones.Any())
        {
            <p class="text-muted">Todas las cuentas están saldadas.</p>
        }
        else
        {
            <ul class="list-group mb-4">
                @foreach (var l in Model.Liquidaciones)
                {
                    <li class="list-group-item d-flex justify-content-between">
                        <span><strong>@l.De</strong> paga a <strong>@l.A</strong></span>
                        <span class="fw-semibold">@l.Importe.ToString("N2", es) €</span>
                    </li>
                }
            </ul>
        }
    }